# Copiar este archivo como .env y poner las llaves reales.
# El .env nunca se sube a git.

ANTHROPIC_API_KEY=sk-ant-...
ELEVENLABS_API_KEY=...

# URL secreta de iCal del Google Calendar del negocio.
# Se saca en: Configuración del calendario → Integrar calendario → Dirección secreta en formato iCal
CALENDARIO_ICAL=https://calendar.google.com/calendar/ical/.../basic.ics
