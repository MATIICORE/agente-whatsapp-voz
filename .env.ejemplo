# Copiar este archivo como .env y poner las llaves reales.
# El .env nunca se sube a git.

ANTHROPIC_API_KEY=sk-ant-...
ELEVENLABS_API_KEY=...

# URL secreta de iCal del Google Calendar del negocio.
# Se saca en: Configuración del calendario → Integrar calendario → Dirección secreta en formato iCal
CALENDARIO_ICAL=https://calendar.google.com/calendar/ical/.../basic.ics

# ── WhatsApp Cloud API (Meta) ──
# Los pasos para conseguir estos cuatro están en CONECTAR-WHATSAPP.md.
# Para revisar que quedaron bien:  python3 whatsapp.py --probar

# Token de la app. El temporal dura 24 h; el permanente sale de un usuario del sistema.
WA_TOKEN=EAA...

# El identificador del número emisor. OJO: no es el número de teléfono, es un id largo.
WA_PHONE_ID=123456789012345

# Una palabra que inventas tú. Solo tiene que coincidir con la que pongas en Meta.
WA_VERIFY_TOKEN=inventa-una-palabra

# Clave secreta de la app (Configuración → Básica → Mostrar).
# Sirve para comprobar que cada mensaje viene de Meta y no de un desconocido.
WA_APP_SECRET=...
